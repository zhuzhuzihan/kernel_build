diff --git a/kernel/sched/tune.c b/kernel/sched/tune.c
index b04122d..6c62069 100644
--- a/kernel/sched/tune.c
+++ b/kernel/sched/tune.c
@@ -575,6 +575,26 @@ int schedtune_prefer_idle(struct task_struct *p)
 	return prefer_idle;
 }
 
+bool schedtune_task_colocated(struct task_struct *p)
+{
+#ifdef CONFIG_SCHED_WALT
+	struct schedtune *st;
+	bool colocate;
+
+	if (unlikely(!schedtune_initialized))
+		return false;
+
+	rcu_read_lock();
+	st = task_schedtune(p);
+	colocate = st->colocate;
+	rcu_read_unlock();
+
+	return colocate;
+#else
+	return false;
+#endif
+}
+
 static u64
