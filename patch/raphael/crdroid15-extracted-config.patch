 void schedtune_enqueue_task(struct task_struct *p, int cpu);
 void schedtune_dequeue_task(struct task_struct *p, int cpu);
@@ -35,7 +36,11 @@ void schedtune_dequeue_task(struct task_struct *p, int cpu);
